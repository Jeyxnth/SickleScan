<?xml version="1.0" encoding="utf-8"?>
<!-- One condition's result. Each selected condition gets its own card: its own
     confidence, referral status and disclaimer, never merged into one number. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/diseaseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/result_text_dark"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/resultIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/resultLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="?attr/textAppearanceTitleLarge" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/result_text_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/referralMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold" />

        <!-- Wide-field malaria: cells analysed, timing, and the validated sensitivity / false-alarm context. -->
        <TextView
            android:id="@+id/resultDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/result_text_dark"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overrideCaveat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/guardrail_override_caveat"
            android:textColor="@color/result_text_dark"
            android:textStyle="italic"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/screening_disclaimer"
            android:textColor="@color/result_text_dark"
            android:textStyle="italic" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
