<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="#EEEEEE"
                android:scaleType="centerInside"
                android:contentDescription="@string/no_image_selected" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/noImageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_image_selected"
            android:textColor="@color/disclaimer_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTakePhoto"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/take_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseGallery"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/choose_from_gallery" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/analyzing" />
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/status_positive"
            android:visibility="gone" />

        <!-- Guardrail rejection: soft warning (Retake / Continue anyway) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/guardrailContainer"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/guardrailMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/guardrail_reject_message"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/status_borderline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardrailRetake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/guardrail_retake" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardrailAnyway"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/guardrail_continue_anyway" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Disease selection: shown after the image passes (or is overridden past) the guardrail -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionContainer"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/select_conditions_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/overrideNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/guardrail_continuing_note"
                    android:textColor="@color/status_borderline"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkSickleCell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/disease_sickle_cell" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkMalaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/disease_malaria" />

                <!-- Phase 13: which kind of malaria photo this is. Shown only while Malaria is ticked. -->
                <RadioGroup
                    android:id="@+id/malariaModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioWideField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/malaria_mode_wide" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/radioSingleCell"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/malaria_mode_single" />
                </RadioGroup>

                <TextView
                    android:id="@+id/malariaHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="@string/malaria_hint_wide"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/disclaimer_gray"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnalyze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:enabled="false"
                    android:text="@string/analyze" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shown above the results whenever two conditions' results are displayed together -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/crossDomainWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/status_borderline_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/status_borderline"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cross_domain_warning_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/result_text_dark"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cross_domain_warning"
                    android:textColor="@color/result_text_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- One result card per selected condition is added here at runtime (item_result_card) -->
        <LinearLayout
            android:id="@+id/resultsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/disclaimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/screening_disclaimer"
            android:textStyle="italic"
            android:textColor="@color/disclaimer_gray" />

    </LinearLayout>
</ScrollView>
