venv/
__pycache__/
*.pyc

# Raw datasets (downloaded separately, not committed) -- covers data/raw/
# (sickle cell) and data/<disease>/raw/ (malaria and any future disease)
data/raw/
data/*/raw/
data/*/*.zip

# Large intermediate training artifacts (final deliverables live in model_output/)
artifacts/

# Phase 7 guardrail: extracted negative-class images (regenerable via scripts/guardrail/build_dataset.py)
data/guardrail/negatives/

# Phase 9a validation photos (user-supplied, possibly sensitive): never commit
data/tiling_validation/**/*.jpg
data/tiling_validation/**/*.jpeg
data/tiling_validation/**/*.png

# Phase 10 demo crops derived from BBBC041 (licence for redistribution not verified): keep local
demo_images/

# Figures that reproduce user-supplied photos or BBBC041 images (redistribution terms unverified): keep local
model_output/tiling/user_photo*.png
model_output/bbbc041/complete_A.png
model_output/bbbc041/photo2_oracle.png
model_output/bbbc041/photo_overlays_new.png
data/tiling_validation/**/*.webp
data/tiling_validation/**/*.gif
data/tiling_validation/**/*.bmp
data/tiling_validation/**/*.tif
data/tiling_validation/**/*.tiff

# Phase 11a: overlays derived from user photos / BBBC041 / third-party fields stay local
model_output/detector/*.png

# Phase 14: third-party / BBBC041-derived images stay local
data/guardrail/fresh_negatives/
data/guardrail/bbbc_crops/
model_output/guardrail/*.png
